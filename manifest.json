{
  "manifest_version": 3,
  "name": "Finder for Folders",
  "version": "0.1.0",
  "description": "Makes your browser's file:// folder listing look like macOS Finder.",
  "host_permissions": ["file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["vendor-pdf.min.js", "content.js"],
      "css": ["finder.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor-pdf.worker.min.js"],
      "matches": ["file:///*"]
    }
  ]
}
